# Eye EMR is a Node-only service. Keep local model/training data and unrelated
# product sources out of the Cloud Build upload.
*

!cloudbuild.node-service.yaml
!package.json

!services/
services/*
!services/node-service.Dockerfile
!services/eye-api/
services/eye-api/*
!services/eye-api/package.json
!services/eye-api/src/
!services/eye-api/src/**
!services/platform-api/
services/platform-api/*
!services/platform-api/package.json
!services/platform-api/src/
services/platform-api/src/*
!services/platform-api/src/store/
!services/platform-api/src/store/**
!services/platform-api/src/auth/
services/platform-api/src/auth/*
!services/platform-api/src/auth/field-secret.js
!services/platform-api/src/auth/password.js
!services/platform-api/src/billing/
services/platform-api/src/billing/*
!services/platform-api/src/billing/catalog.js

!packages/
packages/*
!packages/auth-client/
packages/auth-client/*
!packages/auth-client/package.json
!packages/auth-client/src/
!packages/auth-client/src/**
!packages/eye-contracts/
packages/eye-contracts/*
!packages/eye-contracts/package.json
!packages/eye-contracts/src/
!packages/eye-contracts/src/**
!packages/eye-core/
packages/eye-core/*
!packages/eye-core/package.json
!packages/eye-core/src/
!packages/eye-core/src/**
!packages/firestore-schema/
packages/firestore-schema/*
!packages/firestore-schema/package.json
!packages/firestore-schema/src/
!packages/firestore-schema/src/**
!packages/medical-core/
packages/medical-core/*
!packages/medical-core/package.json
!packages/medical-core/src/
packages/medical-core/src/*
!packages/medical-core/src/lib/
packages/medical-core/src/lib/*
!packages/medical-core/src/lib/field-crypto.js
!packages/platform-contracts/
packages/platform-contracts/*
!packages/platform-contracts/package.json
!packages/platform-contracts/src/
!packages/platform-contracts/src/**

# The shared Dockerfile copies /python for all Node services. Include one small
# file so the directory exists without uploading fee masters or model artifacts.
!python/
python/*
!python/README.md
